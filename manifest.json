{
  "schemaVersion": 1,
  "id": "io.github.gustavonline.passwordless-sudo",
  "name": "Omarchy Agent Access",
  "version": "0.5.0",
  "author": "Gustav Andersen",
  "license": "MIT",
  "description": "Phone-approved access windows for local and remote agents.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Agent Access",
    "description": "Phone-approved access windows for local and remote agents.",
    "category": "System",
    "aliases": [
      "sudo",
      "agent",
      "remote",
      "approval"
    ],
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "animations": true,
      "showNativeFlow": false,
      "defaultMinutes": 5
    },
    "schema": [
      {
        "key": "defaultMinutes",
        "type": "integer",
        "label": "Quick access duration (minutes)",
        "min": 1,
        "max": 15,
        "defaultValue": 5
      },
      {
        "key": "animations",
        "type": "boolean",
        "label": "Animate access status",
        "defaultValue": true
      },
      {
        "key": "showNativeFlow",
        "type": "boolean",
        "label": "Show legacy Omarchy sudo",
        "defaultValue": false
      }
    ]
  }
}

#!/usr/bin/env bash
set -euo pipefail

timer="omarchy-nopasswd-expire-${USER}.timer"

launch_passwordless_flow() {
  local minutes="${1:-}" terminal_id=""

  terminal_id=$(xdg-terminal-exec --print-id 2>/dev/null || true)

  # Warp can be the desktop default, but its Linux launcher does not implement
  # xdg-terminal-exec's command flag (-e). Keep Warp as the user's default and
  # use Omarchy's bundled Foot terminal only for this interactive system flow.
  if [[ $terminal_id == dev.warp.Warp.desktop ]]; then
    command -v foot >/dev/null || {
      printf 'Foot is required for Omarchy command windows when Warp is the default terminal\n' >&2
      exit 1
    }

    # Match the presentation and window identity used by Omarchy's launcher.
    source omarchy-restart-gum
    local passwordless_command="omarchy-sudo-passwordless"
    [[ -n $minutes ]] && passwordless_command+=" $minutes"
    local presentation_script
    presentation_script="omarchy-show-logo; $passwordless_command; if (( \$? != 130 )); then omarchy-show-done; fi"

    exec setsid uwsm-app -- foot \
      --app-id=org.omarchy.terminal \
      --title=Omarchy \
      bash -c "$presentation_script"
  fi

  if [[ -n $minutes ]]; then
    exec omarchy-launch-floating-terminal-with-presentation \
      omarchy-sudo-passwordless "$minutes"
  else
    exec omarchy-launch-floating-terminal-with-presentation \
      omarchy-sudo-passwordless
  fi
}

status_json() {
  local active=false timer_active=false expires="" remaining=0 label="Password required"

  # Omarchy owns both the sudoers rule and this expiration timer. Inspecting
  # the timer is unprivileged and avoids background sudo attempts or prompts.
  if systemctl is-active --quiet "$timer" 2>/dev/null; then
    active=true
    timer_active=true
    label="Passwordless sudo active"
    # systemd-run creates this as a monotonic timer, so its realtime property is
    # empty. Read the raw monotonic deadline over D-Bus and subtract uptime.
    local unit_reply object_path timer_reply next_usec uptime_seconds
    unit_reply=$(busctl call \
      org.freedesktop.systemd1 \
      /org/freedesktop/systemd1 \
      org.freedesktop.systemd1.Manager \
      GetUnit s "$timer" 2>/dev/null || true)
    object_path=${unit_reply#*\"}
    object_path=${object_path%\"}

    if [[ $object_path == /org/freedesktop/systemd1/unit/* ]]; then
      timer_reply=$(busctl get-property \
        org.freedesktop.systemd1 \
        "$object_path" \
        org.freedesktop.systemd1.Timer \
        NextElapseUSecMonotonic 2>/dev/null || true)
      next_usec=${timer_reply##* }
      uptime_seconds=$(awk '{ print $1 }' /proc/uptime)

      if [[ $next_usec =~ ^[0-9]+$ && $uptime_seconds =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        remaining=$(awk -v deadline="$next_usec" -v uptime="$uptime_seconds" \
          'BEGIN { remaining = int((deadline / 1000000) - uptime); print (remaining > 0 ? remaining : 0) }')
        expires=$(date --date="@$(( $(date +%s) + remaining ))" --iso-8601=seconds 2>/dev/null || true)
      fi
    fi
  fi

  jq -nc \
    --argjson active "$active" \
    --argjson timerActive "$timer_active" \
    --argjson remainingSeconds "$remaining" \
    --arg expires "$expires" \
    --arg label "$label" \
    '{active:$active,timerActive:$timerActive,remainingSeconds:$remainingSeconds,expires:$expires,label:$label}'
}

launch_duration() {
  local minutes="${1:-}"
  [[ $minutes =~ ^[0-9]+$ ]] && (( minutes >= 1 && minutes <= 1440 )) || {
    printf 'Minutes must be an integer from 1 to 1440\n' >&2
    exit 2
  }

  launch_passwordless_flow "$minutes"
}

disable_now() {
  launch_passwordless_flow
}

case "${1:-status}" in
  status) status_json ;;
  launch) launch_duration "${2:-}" ;;
  disable) disable_now ;;
  *)
    printf 'Usage: %s {status|launch MINUTES|disable}\n' "${0##*/}" >&2
    exit 2
    ;;
esac
